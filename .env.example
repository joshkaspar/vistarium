# Copy to .env and fill in as needed. .env is gitignored -- never commit
# a real key or a real local network address.

# Required: the OpenAI-compatible endpoint for the local vision model
# (model_client.py) that performs the three judgment calls -- time-of-day,
# license/rights ambiguity, subject/composition. This is a local inference
# box on your own network (e.g. llama-swap, Ollama, LM Studio); there is no
# public default, since it points at hardware only you have.
WOPR_BASE_URL=http://192.168.1.100:8080

# NPS Gallery (npgallery.nps.gov) has no published API and needs no key
# for the current scraper (nps_client.py) -- it's plain HTML scraping.
# Nothing required here yet for the NPS-only phase.

# Future sources (see project-kickoff.md's build order step 6) will need
# real keys here, e.g.:
# SMITHSONIAN_API_KEY=
# LOC_API_KEY=
